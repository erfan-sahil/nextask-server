{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "NexTask Auth API",
    "description": "JWT authentication endpoints for NexTask backend.\n\nImport: Postman → Import → select this file.\n\nCookies (`accessToken`, `refreshToken`) are set on register/login/refresh. For cookie auth, enable cookies in Postman. Bearer token is auto-saved from responses via test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Verify the API server is running."
      },
      "response": []
    },
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  if (json.data && json.data.accessToken) {",
              "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"username\": \"johndoe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password1\"\n}"
        },
        "url": "{{baseUrl}}/auth/register",
        "description": "Create a new user. Sets JWT cookies and returns user + accessToken."
      },
      "response": []
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json.data && json.data.accessToken) {",
              "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password1\"\n}"
        },
        "url": "{{baseUrl}}/auth/login",
        "description": "Login with email and password."
      },
      "response": []
    },
    {
      "name": "Get Me",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me",
        "description": "Get current authenticated user. Requires accessToken cookie or Bearer token."
      },
      "response": []
    },
    {
      "name": "Refresh Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json.data && json.data.accessToken) {",
              "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/auth/refresh",
        "description": "Rotate tokens using refreshToken cookie."
      },
      "response": []
    },
    {
      "name": "Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('accessToken', '');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/auth/logout",
        "description": "Logout and clear auth cookies."
      },
      "response": []
    }
  ]
}
