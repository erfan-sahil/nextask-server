    {
      "name": "Workspaces",
      "item": [
        {
          "name": "Create Workspace",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.workspace && res.data.workspace._id) {",
                  "        pm.collectionVariables.set('workspaceId', res.data.workspace._id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Team\",\n  \"description\": \"Main workspace for the team\",\n  \"visibility\": \"PRIVATE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://{{host}}:{{port}}/api/v1/workspaces",
              "protocol": "http",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "v1",
                "workspaces"
              ]
            },
            "description": "Creates a workspace. Slug is auto-generated from name if omitted.\n\nOptional fields: slug, logo, ownerId, status (ACTIVE | ARCHIVED)\nVisibility: PRIVATE | TEAM | PUBLIC"
          },
          "response": []
        },
        {
          "name": "List Workspaces",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{host}}:{{port}}/api/v1/workspaces?page=1&limit=10",
              "protocol": "http",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "v1",
                "workspaces"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (max: 100, default: 10)"
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "description": "ACTIVE | ARCHIVED",
                  "disabled": true
                },
                {
                  "key": "visibility",
                  "value": "PRIVATE",
                  "description": "PRIVATE | TEAM | PUBLIC",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "team",
                  "description": "Search by name or slug",
                  "disabled": true
                }
              ]
            },
            "description": "Returns workspaces owned by the authenticated user with pagination."
          },
          "response": []
        },
