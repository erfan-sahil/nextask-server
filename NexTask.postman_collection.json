                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Updated Team\",\n  \"description\": \"Updated workspace description\",\n  \"visibility\": \"TEAM\"\n}",
              "options": {
